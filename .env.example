# Copy to .env locally and fill values from your Supabase project settings.
# Never commit .env or real credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional, dedicated credentials for Forge's INTERNAL sync ledger database only.
# Do not set these to a customer's Supabase project. The background sync worker
# remains disabled until both values are configured and the internal ledger migration
# has been applied to that internal database.
FORGE_INTERNAL_SUPABASE_URL=
FORGE_INTERNAL_SUPABASE_SERVICE_ROLE_KEY=

# Optional shared secret for the bounded, read-only project sync worker trigger.
# Generate at least 32 random URL-safe characters. Never expose this value to browsers.
# The endpoint remains disabled until this and the internal ledger credentials are set.
FORGE_SYNC_WORKER_SECRET=
